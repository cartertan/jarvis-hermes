# Copy the variables you need into the matching profile's .env file
# (for example ~/.hermes/.env or ~/.hermes/profiles/<agent>/.env).
# Never put real values in this file. Never commit a real .env.

# --- Telegram gateway (Phase 5, jarvis profile) ---
TELEGRAM_BOT_TOKEN=<from @BotFather>
TELEGRAM_ALLOWED_USERS=<your numeric Telegram user ID only>
TELEGRAM_HOME_CHANNEL=<optional chat ID for scheduled results>

# --- OpenRouter (scout profile only) ---
OPENROUTER_API_KEY=<scout only, never presales>

# --- Garmin MCP (coach profile only) ---
GARMIN_EMAIL=<your Garmin login>
GARMIN_PASSWORD=<your Garmin password>

# --- Voice transcription (optional, sends audio to OpenAI) ---
VOICE_TOOLS_OPENAI_KEY=<leave unset unless you accept this>
